// Grafana Alloy — log-collector voor de WSS-stack.
// Alles gaat naar Loki op wss-loki:3100.

loki.write "default" {
	endpoint {
		url = "http://wss-loki:3100/loki/api/v1/push"
	}
	external_labels = {
		host = "wss-nas",
	}
}

// ---------------------------------------------------------------
// 1) Docker-container logs (stdout/stderr van alle containers)
//    dekt o.a. Apache access/error van wss-webserver.
// ---------------------------------------------------------------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.containers.output
	forward_to    = [loki.write.default.receiver]
	labels        = { job = "docker" }
	relabel_rules = discovery.relabel.containers.rules
}

// ---------------------------------------------------------------
// 2) Bestandslogs op de NAS (alle mounts read-only)
// ---------------------------------------------------------------
// local.file_match expandeert globs naar echte bestanden — loki.source.file
// doet dat NIET zelf (een letterlijke "*.log" in __path__ faalt op stat).
// Bonus: targets verschijnen pas als het bestand bestaat -> geen
// "failed to tail file"-fouten meer voor nog-niet-bestaande logs.
local.file_match "wss_cron_logs" {
	// devin-cron output: backup.log, logpull.log, noise-review.log, ...
	path_targets = [{__path__ = "/logsrc/wss/*.log", job = "wss-cron", level = "info"}]
	sync_period  = "15s"
}

local.file_match "webstack_logs" {
	// wss-webserver: mail-catcher (file bestaat pas zodra mail valt)
	path_targets = [{__path__ = "/logsrc/webstack/*.log", job = "mail-catcher", level = "info"}]
	sync_period  = "15s"
}

loki.source.file "wss_files" {
	targets = concat(
		local.file_match.wss_cron_logs.targets,
		local.file_match.webstack_logs.targets,
	)
	// site-app logs komen via wss_log_pull.sh (devin-cron,
	// 15-min pull -> Loki push API) — bewust géén file-tail
	// op de backup-mirror: dat gaf dubbele regels.
	forward_to = [loki.write.default.receiver]
}

// ---------------------------------------------------------------
// 3) Metrics: Uptime Kuma /metrics -> VictoriaMetrics
//    API-key via KUMA_API_KEY env (basic-auth password).
// ---------------------------------------------------------------
prometheus.scrape "kuma" {
	targets         = [{ __address__ = "wss-monitoring:3001" }]
	metrics_path    = "/metrics"
	scrape_interval = "30s"

	basic_auth {
		username = ""
		password = env("KUMA_API_KEY")
	}

	forward_to = [prometheus.relabel.kuma_env.receiver]
}

// wss_env-label op Kuma-metrics, zelfde waarden als de site-app
// env-labels: 'test_env' als monitor-naam of -url 'test' bevat
// (example-test, /test_env/, Backend - TEST, ...), anders 'full_site'.
prometheus.relabel "kuma_env" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		target_label = "wss_env"
		replacement  = "full_site"
	}
	rule {
		source_labels = ["monitor_name"]
		regex         = "(?i).*test.*"
		target_label  = "wss_env"
		replacement   = "test_env"
	}
	rule {
		source_labels = ["monitor_url"]
		regex         = "(?i).*test.*"
		target_label  = "wss_env"
		replacement   = "test_env"
	}
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://wss-metrics:8428/api/v1/write"
	}
}
