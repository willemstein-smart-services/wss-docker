// Grafana Alloy — log-collector voor de WSS-stack.
// Alles gaat naar Loki op wss-loki:3100.

loki.write "default" {
	endpoint {
		url = "http://wss-loki:3100/loki/api/v1/push"
	}
	external_labels = {
		host = "wss-nas",
	}
}

// ---------------------------------------------------------------
// 1) Docker-container logs (stdout/stderr van alle containers)
//    dekt o.a. Apache access/error van wss-webserver.
// ---------------------------------------------------------------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.containers.output
	forward_to    = [loki.write.default.receiver]
	labels        = { job = "docker" }
	relabel_rules = discovery.relabel.containers.rules
}

// ---------------------------------------------------------------
// 2) Bestandslogs op de NAS (alle mounts read-only)
// ---------------------------------------------------------------
loki.source.file "wss_files" {
	targets = [
		// devin-cron output: backup.log, intake.log, ...
		{ __path__ = "/logsrc/wss/*.log", job = "wss-cron", level = "info" },
		// wss-webserver: mail-catcher
		{ __path__ = "/logsrc/webstack/mail.log", job = "mail-catcher", level = "info" },
		// site-app logs komen via wss_log_pull.sh (devin-cron,
		// 15-min pull -> Loki push API) — bewust géén file-tail
		// op de backup-mirror: dat gaf dubbele regels.
	]
	forward_to = [loki.write.default.receiver]
}

// ---------------------------------------------------------------
// 3) Metrics: Uptime Kuma /metrics -> VictoriaMetrics
//    API-key via KUMA_API_KEY env (basic-auth password).
// ---------------------------------------------------------------
prometheus.scrape "kuma" {
	targets         = [{ __address__ = "wss-monitoring:3001" }]
	metrics_path    = "/metrics"
	scrape_interval = "30s"

	basic_auth {
		username = ""
		password = env("KUMA_API_KEY")
	}

	forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://wss-metrics:8428/api/v1/write"
	}
}
