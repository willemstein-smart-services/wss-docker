// Grafana Alloy — log-collector voor de WSS-stack.
// Alles gaat naar Loki op wss-loki:3100.

loki.write "default" {
	endpoint {
		url = "http://wss-loki:3100/loki/api/v1/push"
	}
	external_labels = {
		host = "wss-nas",
	}
}

// ---------------------------------------------------------------
// 1) Docker-container logs (stdout/stderr van alle containers)
//    dekt o.a. Apache access/error van wss-webserver.
// ---------------------------------------------------------------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.containers.output
	forward_to    = [loki.write.default.receiver]
	labels        = { job = "docker" }
	relabel_rules = discovery.relabel.containers.rules
}

// ---------------------------------------------------------------
// 2) Bestandslogs op de NAS (alle mounts read-only)
// ---------------------------------------------------------------
// local.file_match expandeert globs naar echte bestanden — loki.source.file
// doet dat NIET zelf (een letterlijke "*.log" in __path__ faalt op stat).
// Bonus: targets verschijnen pas als het bestand bestaat -> geen
// "failed to tail file"-fouten meer voor nog-niet-bestaande logs.
local.file_match "wss_cron_logs" {
	// devin-cron output: backup.log, logpull.log, noise-review.log, ...
	path_targets = [{__path__ = "/logsrc/wss/*.log", job = "wss-cron", level = "info"}]
	sync_period  = "15s"
}

local.file_match "webstack_logs" {
	// wss-webserver: mail-catcher (file bestaat pas zodra mail valt)
	path_targets = [{__path__ = "/logsrc/webstack/*.log", job = "mail-catcher", level = "info"}]
	sync_period  = "15s"
}

loki.source.file "wss_files" {
	targets = concat(
		local.file_match.wss_cron_logs.targets,
		local.file_match.webstack_logs.targets,
	)
	// site-app logs komen via wss_log_pull.sh (devin-cron,
	// 15-min pull -> Loki push API) — bewust géén file-tail
	// op de backup-mirror: dat gaf dubbele regels.
	forward_to = [loki.process.wss_files.receiver]
}

// wss-cron/mail-catcher bestanden krijgen van file_match statisch
// level=info — leid het echte level af uit de regeltekst zodat de
// cron-error kaart (WSS Overall) op het label kan filteren.
loki.process "wss_files" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		expression = `(?i)\b(?P<sev_word>fatal|crit(?:ical)?|panic|error|fout|failed|mislukt|exception|traceback|denied|refused|warn(?:ing)?)\b`
	}
	stage.template {
		source   = "level_derived"
		template = `{{ if .sev_word }}{{ $w := .sev_word | lower }}{{ if or (eq $w "warn") (eq $w "warning") }}warn{{ else if or (eq $w "fatal") (eq $w "panic") (eq $w "crit") (eq $w "critical") }}crit{{ else }}err{{ end }}{{ else }}info{{ end }}`
	}
	stage.labels {
		values = {
			level = "level_derived",
		}
	}
}

// ---------------------------------------------------------------
// 3) Netwerk-syslog: syslog-ng schrijft JSON-regels
//    (/var/log/syslog-ng/syslog-<datum>.log -> /logsrc/syslog hier).
//    LEVEL/HOST/PROGRAM komen al geparsed binnen -> labels.
// ---------------------------------------------------------------
local.file_match "syslog_logs" {
	path_targets = [{__path__ = "/logsrc/syslog/*.log", job = "syslog"}]
	sync_period  = "15s"
}

loki.source.file "syslog" {
	targets    = local.file_match.syslog_logs.targets
	forward_to = [loki.process.syslog.receiver]
}

loki.process "syslog" {
	forward_to = [loki.write.default.receiver]

	stage.json {
		expressions = {
			level_raw = "LEVEL",
			shost     = "HOST",
			program   = "PROGRAM",
			msg       = "MSG",
		}
	}

	// syslog-severity -> wss-level conventie (zelfde als site-app:
	// crit|alert|err|warn|notice|info|debug). emerg telt als alert.
	stage.template {
		source   = "level"
		template = `{{ $l := .level_raw | lower }}{{ if or (eq $l "emerg") (eq $l "panic") (eq $l "alert") }}alert{{ else if eq $l "crit" }}crit{{ else if or (eq $l "err") (eq $l "error") }}err{{ else if or (eq $l "warning") (eq $l "warn") }}warn{{ else if eq $l "notice" }}notice{{ else if eq $l "debug" }}debug{{ else }}info{{ end }}`
	}

	stage.labels {
		values = {
			level   = "level",
			shost   = "shost",
			program = "program",
		}
	}

	// zigbee2mqtt is praatziek: info/debug droppen vóór Loki.
	// Match op program én shost (z2m kan als host óf program
	// binnenkomen); warn+ blijft gewoon zichtbaar.
	// expression=".*" is verplicht: een kale drop zonder
	// source/expression/older_than/longer_than weigert Alloy.
	stage.match {
		selector = "{program=~\"(?i).*zigbee2mqtt.*\", level=~\"info|debug\"}"
		stage.drop {
			expression          = ".*"
			drop_counter_reason = "z2m_lowprio"
		}
	}
	stage.match {
		selector = "{shost=~\"(?i).*zigbee2mqtt.*\", level=~\"info|debug\"}"
		stage.drop {
			expression          = ".*"
			drop_counter_reason = "z2m_lowprio"
		}
	}

	// UniFi firewall-regels: [RULESET-NR-V]KEY=V ... (iptables-formaat,
	// bv. [WAN_OUT-2001-R]IN=.. OUT=.. SRC=.. DST=.. PROTO=UDP SPT=.. DPT=..).
	// fw_rule/proto/action = labels (lage cardinaliteit); adressen/poorten
	// gaan als structured metadata mee -> querybaar maar niet geïndexeerd.
	stage.regex {
		source     = "msg"
		expression = `^\[(?P<fw_rule>[A-Z][A-Z_0-9]*-[0-9]+-[ARD])\](?P<fw_kv>.*)`
	}
	stage.logfmt {
		source  = "fw_kv"
		mapping = {
			fw_in    = "IN",
			fw_out   = "OUT",
			fw_src   = "SRC",
			fw_dst   = "DST",
			fw_proto = "PROTO",
			fw_spt   = "SPT",
			fw_dpt   = "DPT",
			fw_mac   = "MAC",
			fw_ttl   = "TTL",
			fw_id    = "ID",
		}
	}
	// BEGIN unifi-names
	stage.template {
		source   = "fw_src_name"
		template = `{{ index (dict "10.10.10.16" "USG-Pro-4" "192.168.1.17" "Philips HUE - Bridge" "192.168.1.31" "Synology DS214 NAS - Primary IP" "192.168.1.32" "Synology DS1520 NAS - Primary IP" "192.168.1.59" "Laptop-Erik" "192.168.1.190" "USW Flex Mini - Vliering IOT" "192.168.1.191" "USW Flex Mini - Werkplek" "192.168.1.194" "motorola-edge-70" "192.168.1.196" "Cloud-Key-Gen2-Plus" "192.168.1.197" "UAP-AC-PRO - Zolder" "192.168.1.199" "USW Flex Mini - TV Meubel" "192.168.1.200" "voordeur" "192.168.1.201" "USW Flex Mini - Meterkast 1.1" "192.168.1.204" "S24-van-Jo" "192.168.1.205" "TV - Woonkamer" "192.168.1.206" "UAP-AC-PRO - Woonkamer" "192.168.1.209" "SLZB-06 - Bar - Zigbee to UTP" "192.168.1.211" "S21-FE-van-Alissa" "192.168.1.213" "US 8 60W Meterkast" "192.168.1.215" "Growatt ShineLine" "192.168.1.217" "UAP-AC-PRO - 1e Verdieping" "192.168.1.219" "UAP-AC-LR - TuinBar" "192.168.1.220" "Motorola Lucas" "192.168.1.222" "US 8 60W vliering" "192.168.10.2" "Synology DS1520 NAS - Docker IP" "192.168.10.3" "PiHole v3 - DNS Server" "192.168.10.11" "SabNZBd" "192.168.10.12" "Sonarr" "192.168.22.6" "Nest-Audio" "192.168.22.7" "Google Nest Mini - Badkamer" "192.168.22.8" "Nest-Audio" "192.168.22.9" "Google-Nest-Hub" "192.168.22.11" "Google-Nest-Hub" "192.168.22.36" "Google-Nest-Hub" "192.168.22.43" "Wyze Cam - Woonkamer" "192.168.22.49" "Wyze Cam - Gang" "192.168.22.54" "Wyze Cam - Tuin Carport" "192.168.22.56" "Wyze Cam - Tuin Bar" "192.168.22.57" "Wyze Cam - Keuken" "192.168.22.131" "nrg-itho-2ec4" "192.168.22.135" "Masterbedroom" "192.168.22.136" "smile0682f8" "192.168.22.137" "waterlezer" "192.168.22.141" "tado" "192.168.22.143" "Somfy - Connexoon" "192.168.22.146" "Petkit_D4" "192.168.22.147" "homeassistant" "192.168.22.169" "Petkit_D4" "192.168.22.173" "HPD29027" "192.168.22.202" "Airco Zolder" "192.168.22.203" "HoyMiles - Solar PV Box" "192.168.66.242" "A16-van-Eva" "192.168.66.243" "Mac" "192.168.255.251" "iPhone" ) .fw_src | default "" }}`
	}
	stage.template {
		source   = "fw_dst_name"
		template = `{{ index (dict "10.10.10.16" "USG-Pro-4" "192.168.1.17" "Philips HUE - Bridge" "192.168.1.31" "Synology DS214 NAS - Primary IP" "192.168.1.32" "Synology DS1520 NAS - Primary IP" "192.168.1.59" "Laptop-Erik" "192.168.1.190" "USW Flex Mini - Vliering IOT" "192.168.1.191" "USW Flex Mini - Werkplek" "192.168.1.194" "motorola-edge-70" "192.168.1.196" "Cloud-Key-Gen2-Plus" "192.168.1.197" "UAP-AC-PRO - Zolder" "192.168.1.199" "USW Flex Mini - TV Meubel" "192.168.1.200" "voordeur" "192.168.1.201" "USW Flex Mini - Meterkast 1.1" "192.168.1.204" "S24-van-Jo" "192.168.1.205" "TV - Woonkamer" "192.168.1.206" "UAP-AC-PRO - Woonkamer" "192.168.1.209" "SLZB-06 - Bar - Zigbee to UTP" "192.168.1.211" "S21-FE-van-Alissa" "192.168.1.213" "US 8 60W Meterkast" "192.168.1.215" "Growatt ShineLine" "192.168.1.217" "UAP-AC-PRO - 1e Verdieping" "192.168.1.219" "UAP-AC-LR - TuinBar" "192.168.1.220" "Motorola Lucas" "192.168.1.222" "US 8 60W vliering" "192.168.10.2" "Synology DS1520 NAS - Docker IP" "192.168.10.3" "PiHole v3 - DNS Server" "192.168.10.11" "SabNZBd" "192.168.10.12" "Sonarr" "192.168.22.6" "Nest-Audio" "192.168.22.7" "Google Nest Mini - Badkamer" "192.168.22.8" "Nest-Audio" "192.168.22.9" "Google-Nest-Hub" "192.168.22.11" "Google-Nest-Hub" "192.168.22.36" "Google-Nest-Hub" "192.168.22.43" "Wyze Cam - Woonkamer" "192.168.22.49" "Wyze Cam - Gang" "192.168.22.54" "Wyze Cam - Tuin Carport" "192.168.22.56" "Wyze Cam - Tuin Bar" "192.168.22.57" "Wyze Cam - Keuken" "192.168.22.131" "nrg-itho-2ec4" "192.168.22.135" "Masterbedroom" "192.168.22.136" "smile0682f8" "192.168.22.137" "waterlezer" "192.168.22.141" "tado" "192.168.22.143" "Somfy - Connexoon" "192.168.22.146" "Petkit_D4" "192.168.22.147" "homeassistant" "192.168.22.169" "Petkit_D4" "192.168.22.173" "HPD29027" "192.168.22.202" "Airco Zolder" "192.168.22.203" "HoyMiles - Solar PV Box" "192.168.66.242" "A16-van-Eva" "192.168.66.243" "Mac" "192.168.255.251" "iPhone" ) .fw_dst | default "" }}`
	}
	// rulenaam: verdict-letter (-A/-R/-D) eraf, dan RULESET-INDEX -> naam
	stage.template {
		source   = "fw_rule_name"
		template = `{{ $k := regexReplaceAll "-[ARD]$" (.fw_rule | default "") "" }}{{ index (dict "GUEST_IN-2000" "Hoymiles" "GUEST_IN-2001" "NAS  --- TV Return Traffic" "GUEST_IN-2002" "NAS  --- TV" "GUEST_IN-2005" "DNS Rule" "GUEST_IN-2006" "DNS Rule - Return Traffic" "LAN_IN-2001" "NAS  --- TV" "LAN_IN-2002" "DNS Rule" "LAN_OUT-2000" "Growatt Investigation" "WAN_OUT-2000" "F5_BLOCK" "WAN_OUT-2001" "DENY ACCESS IOT" "WAN_OUT-2002" "DNS Tracker" "WAN_OUT-2003" "DNS Tracker IOT" ) $k | default "" }}`
	}
	// END unifi-names

	// UniFi verdict-letter op het einde van de rulenaam: A/R/D.
	stage.template {
		source   = "fw_action"
		template = `{{ $r := .fw_rule | default "" }}{{ if regexMatch "-A$" $r }}accept{{ else if regexMatch "-R$" $r }}reject{{ else if regexMatch "-D$" $r }}drop{{ end }}`
	}
	stage.labels {
		values = {
			fw_rule      = "fw_rule",
			fw_proto     = "fw_proto",
			fw_action    = "fw_action",
			fw_rule_name = "fw_rule_name",
		}
	}
	stage.structured_metadata {
		values = {
			fw_src      = "fw_src",
			fw_dst      = "fw_dst",
			fw_spt      = "fw_spt",
			fw_dpt      = "fw_dpt",
			fw_in       = "fw_in",
			fw_out      = "fw_out",
			fw_mac      = "fw_mac",
			fw_ttl      = "fw_ttl",
			fw_src_name  = "fw_src_name",
			fw_dst_name  = "fw_dst_name",
		}
	}
}

// ---------------------------------------------------------------
// 4) Metrics: Uptime Kuma /metrics -> VictoriaMetrics
//    API-key via KUMA_API_KEY env (basic-auth password).
// ---------------------------------------------------------------
prometheus.scrape "kuma" {
	targets         = [{ __address__ = "wss-monitoring:3001" }]
	metrics_path    = "/metrics"
	scrape_interval = "30s"

	basic_auth {
		username = ""
		password = env("KUMA_API_KEY")
	}

	forward_to = [prometheus.relabel.kuma_env.receiver]
}

// wss_env-label op Kuma-metrics, zelfde waarden als de site-app
// env-labels: 'test_env' als monitor-naam of -url 'test' bevat
// (example-test, /test_env/, Backend - TEST, ...), anders 'full_site'.
prometheus.relabel "kuma_env" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		target_label = "wss_env"
		replacement  = "full_site"
	}
	rule {
		source_labels = ["monitor_name"]
		regex         = "(?i).*test.*"
		target_label  = "wss_env"
		replacement   = "test_env"
	}
	rule {
		source_labels = ["monitor_url"]
		regex         = "(?i).*test.*"
		target_label  = "wss_env"
		replacement   = "test_env"
	}
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://wss-metrics:8428/api/v1/write"
	}
}
