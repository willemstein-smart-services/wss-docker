        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "expr": "monitor_response_time <= 1000",
          "legendFormat": "{{monitor_name}}",
          "refId": "A"
        }
      ],
      "title": "Response time <= 1s",
      "type": "timeseries"
