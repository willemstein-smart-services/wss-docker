{
  "uid": "wss-syslog",
  "title": "WSS Netwerk Syslog",
  "version": 1,
  "editable": true,
  "timezone": "Europe/Amsterdam",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "shost",
        "options": [],
        "refresh": 2,
        "type": "query",
        "query": { "label": "shost", "stream": "{job=\"syslog\"}", "type": 1 }
      },
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "program",
        "options": [],
        "refresh": 2,
        "type": "query",
        "query": { "label": "program", "stream": "{job=\"syslog\"}", "type": 1 }
      },
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "name": "level",
        "options": [],
        "refresh": 2,
        "type": "query",
        "query": { "label": "level", "stream": "{job=\"syslog\"}", "type": 1 }
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "name": "zoek",
        "options": [],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Syslog-regels per host",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (shost) (count_over_time({job=\"syslog\", shost=~\"$shost\"}[$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{shost}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" }, "showPoints": "never" },
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Warn+ per host (alert|crit|err|warn)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (shost) (count_over_time({job=\"syslog\", shost=~\"$shost\", level=~\"alert|crit|err|warn\"}[$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{shost}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" }, "showPoints": "never" },
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Levels in window",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({job=\"syslog\", shost=~\"$shost\", program=~\"$program\", level=~\"$level\"}[$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top program's",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(15, sum by (program) (count_over_time({job=\"syslog\", shost=~\"$shost\", level=~\"$level\"}[$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{program}}"
        }
      ],
      "transformations": [
        { "id": "seriesToTable", "options": {} },
        { "id": "sortBy", "options": { "fields": {}, "sort": [ { "field": "Value", "desc": true } ] } }
      ],
      "fieldConfig": { "defaults": { "mappings": [], "unit": "none" }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Syslog feed",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"syslog\", shost=~\"$shost\", program=~\"$program\", level=~\"$level\"} |~ \"$zoek\" | json | line_format `{{ .ISODATE }} {{ .HOST }} {{ .PROGRAM }}{{ if .PID }}[{{ .PID }}]{{ end }}: {{ .MSG }}`",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
