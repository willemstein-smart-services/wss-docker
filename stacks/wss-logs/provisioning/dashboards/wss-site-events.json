          "expr": "topk(10, sum by (ip) (count_over_time({job=\"site-app\", env=\"$env\"} | regexp `\\d{8} \\d{2}:\\d{2}:\\d{2} - (?P<ip>\\S+)`[$__interval])))",
          "legendFormat": "{{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
