{
  "title": "WSS Site Events",
  "uid": "wss-site-events",
  "tags": [
    "wss",
    "site-app"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 13,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": [
            "test_env"
          ],
          "value": [
            "test_env"
          ]
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "includeAll": false,
        "multi": false,
        "name": "env",
        "options": [],
        "refresh": 2,
        "type": "query",
        "query": {
          "label": "env",
          "stream": "{job=\"site-app\"}",
          "type": 1
        },
        "regex": "/^(test_env|full_site)$/"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "name": "level",
        "options": [],
        "refresh": 2,
        "type": "query",
        "query": {
          "label": "level",
          "stream": "{job=\"site-app\", env=\"$env\"}",
          "type": 1
        }
      },
      {
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "name": "zoek",
        "options": [],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events in periode",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"site-app\", env=\"$env\"}[$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors & alerts",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"site-app\", env=\"$env\", level=~\"err|crit|alert\"}[$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unieke IPs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(count by (ip) (count_over_time({job=\"site-app\", env=\"$env\"} | regexp `\\d{8} \\d{2}:\\d{2}:\\d{2} - (?P<ip>\\S+)`[$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Volume per severity",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({job=\"site-app\", env=\"$env\"}[$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          },
          "unit": "none",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Git / Deploy events",
      "description": "Deploy-pijplijn als tabel: 2FA lock/unlock + deploy-notifications. Volledige commit-msg staat in de laatste kolom (hover voor volledige tekst).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Line": true,
              "labels": true,
              "mo": true,
              "dy": true,
              "hms": true,
              "detail": true,
              "job": true,
              "host": true,
              "src": true,
              "level": true,
              "detected_level": true,
              "service_name": true,
              "filename": true,
              "id": true,
              "tsNs": true,
              "_2fa": true,
              "env": true,
              "msg": true,
              "mail": true,
              "ttl": true,
              "key_provided": true,
              "env_extracted": true,
              "twofa": true,
              "reason": true,
              "user": true,
              "method": true,
              "until": true,
              "source": true,
              "labelTypes": true,
              "LabelTypes": true,
              "deploy": true,
              "branch": true,
              "commit": true
            },
            "indexByName": {
              "level": 0,
              "ts": 1,
              "srcip": 2,
              "event": 3,
              "deployinfo": 4,
              "details": 5
            },
            "renameByName": {
              "ts": "Tijd",
              "srcip": "Src IP",
              "event": "Event",
              "level": "Sev",
              "details": "Details",
              "deployinfo": "Deploy"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"site-app\", env=\"$env\"} |~ \"DEPLOY_2FA|DEPLOY_NOTIFY\" |~ \"$zoek\" | regexp `\\d{4}(?P<mo>\\d{2})(?P<dy>\\d{2}) (?P<hms>\\d{2}:\\d{2}:\\d{2}) - (?P<srcip>\\S+) - (?:(?:alert|crit|err|warn|notice|info|debug) - )?(?P<event>[A-Z0-9_]+)\\s*(?P<detail>\\{.*)?` | line_format `{{ .detail }}` | regexp `\"2fa\":\"(?P<twofa>[^\"]*)\"` | json | label_format ts=\"{{ .dy }}-{{ .mo }} {{ .hms }}\" | label_format details=\"{{ if .msg }}{{ .msg }} {{ end }}{{ if .reason }}{{ .reason }} {{ end }}{{ if .twofa }}[2FA: {{ .twofa }}] {{ end }}{{ if .user }}{{ .user }}{{ end }}{{ if .method }} ({{ .method }}){{ end }}{{ if .until }} until {{ .until }}{{ end }}{{ if .source }} via {{ .source }}{{ end }}\" | label_format deployinfo=\"{{ if .deploy }}{{ .deploy }}{{ end }}{{ if .branch }} | {{ .branch }}{{ end }}{{ if .commit }} | {{ .commit }}{{ end }}\" | line_format `{{ .level }} | {{ .ts }} | {{ .srcip }} | {{ .event }}{{ if .deploy }}: {{ .deploy }}{{ end }}{{ if .branch }} | {{ .branch }}{{ end }}`",
          "refId": "A",
          "queryType": "instant",
          "maxLines": 500
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Errors & alerts",
      "datasource": {
        "type": "loki",
