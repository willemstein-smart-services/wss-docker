    {
      "id": 26,
      "type": "table",
      "title": "TIMER",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "description": "Proof-of-life timers uit het status-endpoint (poll elke 15 min; waarden iets vertraagd)",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Waarde"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": -1000000000000.0,
                      "to": 0,
                      "result": {
                        "text": "LOCKED",
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "label_set(last_over_time(wss_site_hk_state_age_s{env=\"$env\"}[1h]), \"timer\", \"HK leeftijd\") or label_set(time() - ((last_over_time(wss_site_deploy_2fa_until{env=\"$env\"}[1h]) > 0) - 10800), \"timer\", \"2FA unlocked\") or label_set(last_over_time(wss_site_deploy_2fa_until{env=\"$env\"}[1h]) - time(), \"timer\", \"2FA resterend\")"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          },
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "label_set(1000 * (time() - last_over_time(wss_site_hk_state_age_s{env=\"$env\"}[1h])), \"timer\", \"HK leeftijd\") or label_set(1000 * ((last_over_time(wss_site_deploy_2fa_until{env=\"$env\"}[1h]) > 0) - 10800), \"timer\", \"2FA unlocked\") or label_set(1000 * last_over_time(wss_site_deploy_2fa_until{env=\"$env\"}[1h]), \"timer\", \"2FA resterend\")"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "timer",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "env": true,
              "env 1": true,
              "env 2": true,
              "env 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "timer": "Timer",
              "Value A": "Waarde",
              "Value B": "Tijd",
              "Value #A": "Waarde",
              "Value #B": "Tijd",
              "Value (A)": "Waarde",
              "Value (B)": "Tijd",
              "Value 1": "Waarde",
              "Value 2": "Tijd",
              "Value": "Waarde"
            },
            "indexByName": {
              "timer": 0
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Tijd",
                "destinationType": "time",
                "inputFormat": "unixms"
              }
            ]
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Tijd",
                "destinationType": "string",
                "dateFormat": "DD-MM HH:mm:ss"
              }
            ]
          }
        }
      ]
    },
