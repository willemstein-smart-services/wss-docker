      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=~\"wss-cron|mail-catcher\", level=~\"crit|err|warn\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Pentest self-checks (?pts=1) — dagelijkse cron-endpoint verificatie",
      "datasource": {
        "type": "loki",
