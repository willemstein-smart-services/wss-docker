    {
      "id": 10,
      "type": "table",
      "title": "Git / Deploy events",
      "description": "Deploy-pijplijn als tabel: 2FA lock/unlock + deploy-notifications. Volledige commit-msg staat in de laatste kolom (hover voor volledige tekst).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sev"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 65
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Syslog"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tijd"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Src IP"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Deploy"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Line": true,
              "labels": true,
              "mo": true,
              "dy": true,
              "hms": true,
              "detail": true,
              "job": true,
              "host": true,
              "src": true,
              "level": true,
              "detected_level": true,
              "service_name": true,
              "filename": true,
              "id": true,
              "tsNs": true,
              "_2fa": true,
              "env": true,
              "msg": true,
              "mail": true,
              "ttl": true,
              "key_provided": true,
              "env_extracted": true,
              "twofa": true,
              "reason": true,
              "user": true,
              "method": true,
              "until": true,
              "source": true,
              "labelTypes": true,
              "LabelTypes": true,
              "deploy": true,
              "branch": true,
              "commit": true,
              "sev": true
            },
            "indexByName": {
              "level": 0,
              "syslog": 1,
              "ts": 2,
              "srcip": 3,
              "event": 4,
              "deployinfo": 5,
              "details": 6
            },
            "renameByName": {
              "ts": "Tijd",
              "srcip": "Src IP",
              "event": "Event",
              "level": "Sev",
              "details": "Details",
              "deployinfo": "Deploy",
              "syslog": "Syslog"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"site-app\", env=\"$env\"} |~ \"DEPLOY_2FA|DEPLOY_NOTIFY|FTP_\" |~ \"$zoek\" | regexp `\\d{4}(?P<mo>\\d{2})(?P<dy>\\d{2}) (?P<hms>\\d{2}:\\d{2}:\\d{2}) - (?P<srcip>\\S+) - (?:(?P<sev>alert|crit|err|warn|notice|info|debug) - )?(?P<event>[A-Z0-9_]+)\\s*(?P<detail>\\{.*)?` | line_format `{{ .detail }}` | regexp `\"2fa\":\"(?P<twofa>[^\"]*)\"` | json | label_format ts=\"{{ .dy }}-{{ .mo }} {{ .hms }}\" | label_format syslog=\"{{ if .sev }}{{ .sev }}{{ else }}{{ .level }}{{ end }}\" | label_format details=\"{{ if .file }}{{ .file }}{{ end }}{{ if .veld }} ({{ .veld }}){{ end }}{{ if .actie }}: {{ .actie }}{{ end }}{{ if .actor }} [via {{ .actor }}]{{ end }}{{ if .msg }}{{ .msg }} {{ end }}{{ if .reason }}{{ .reason }} {{ end }}{{ if .twofa }}[2FA: {{ .twofa }}] {{ end }}{{ if .user }}{{ .user }}{{ end }}{{ if .method }} ({{ .method }}){{ end }}{{ if .until }} until {{ .until }}{{ end }}{{ if .source }} via {{ .source }}{{ end }}\" | label_format deployinfo=\"{{ if .deploy }}{{ .deploy }}{{ end }}{{ if .branch }} | {{ .branch }}{{ end }}{{ if .commit }} | {{ .commit }}{{ end }}\" | line_format `{{ .level }} | {{ .ts }} | {{ .srcip }} | {{ .event }}{{ if .deploy }}: {{ .deploy }}{{ end }}{{ if .branch }} | {{ .branch }}{{ end }}`",
          "refId": "A",
          "queryType": "instant",
          "maxLines": 500
        }
      ]
    }
  ]
}